{
  "name": "cloud-vault",
  "private": true,
  "scripts": {
    "build": "node init && turbo build",
    "dev": "node init && turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "type": "module",
  "devDependencies": {
    "prettier": "^3.2.5",
